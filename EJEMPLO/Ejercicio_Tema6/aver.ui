  <property name="styleSheet">
   <string notr="true">/* SCROLL VERTICAL */
QScrollBar:vertical {
    border: none;
    background-color: rgb(147, 125, 191);
    width: 14px;
    margin: 0px 0px 0px 0px; /* Sin margen para que ocupe todo el espacio */
    border-radius: 0px;
}

/* MANEJADOR / BARRA */
QScrollBar::handle:vertical {
    background-color: rgb(165, 105, 255);
    min-height: 30px;
    border-radius: 7px;
} 

QScrollBar::handle:vertical:hover {
    background-color: rgb(85, 0, 255);
}

QScrollBar::handle:vertical:pressed {
    background-color: rgb(64, 0, 193);
}

/* OCULTAR BOTÓN SUPERIOR (FLECHA ARRIBA) */
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

/* OCULTAR BOTÓN INFERIOR (FLECHA ABAJO) */
QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

/* ASEGURAR QUE LAS FLECHAS ESTÉN DESAPARECIDAS */
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    background: none;
    height: 0px;
    width: 0px;
}

/* FONDO DEL CANAL / PÁGINA */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}</string>
  </property>
